{
  "name": "@skytech/api",
  "version": "0.0.0",
  "private": true,
  "description": "SkyTech.ru NestJS modular monolith: HTTP API (main), worker (main.worker), CLI (cli)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "node --watch dist/main.worker.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "cli": "node dist/cli.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node dist/cli.js db:seed",
    "db:reset": "node dist/cli.js db:reset",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@node-rs/argon2": "2.2.2",
    "@skytech/content-render": "workspace:*",
    "@skytech/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "file-type": "22.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@skytech/eslint-config": "workspace:*",
    "@skytech/tsconfig": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
