{
  "name": "@skytech/api",
  "version": "0.0.0",
  "private": true,
  "description": "SkyTech.ru NestJS modular monolith (HTTP API; worker and CLI entry points arrive in Phases 2.2 and 3.1)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@skytech/contracts": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@skytech/eslint-config": "workspace:*",
    "@skytech/tsconfig": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "supertest": "7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
