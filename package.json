{
  "name": "skytech",
  "private": true,
  "description": "SkyTech.ru — технический портал для системных администраторов и IT-инженеров",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "infra:up": "docker compose -f docker/compose.dev.yml up -d --wait postgres redis minio && docker compose -f docker/compose.dev.yml run --rm minio-init",
    "infra:down": "docker compose -f docker/compose.dev.yml down",
    "infra:reset": "docker compose -f docker/compose.dev.yml down -v",
    "infra:logs": "docker compose -f docker/compose.dev.yml logs -f --tail=100",
    "db:generate": "pnpm --filter @skytech/api db:generate",
    "db:migrate": "pnpm --filter @skytech/api db:migrate",
    "build:api": "turbo run build --filter=@skytech/api --output-logs=errors-only",
    "db:seed": "pnpm build:api && pnpm --filter @skytech/api db:seed",
    "db:reset": "pnpm build:api && pnpm --filter @skytech/api db:reset",
    "user:create": "pnpm build:api && pnpm --filter @skytech/api cli user:create",
    "user:reset-password": "pnpm build:api && pnpm --filter @skytech/api cli user:reset-password",
    "dev:worker": "pnpm --filter @skytech/api dev:worker",
    "e2e": "pnpm --filter @skytech/web e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
