# Copy to `.env` in the repository root:  Copy-Item .env.example .env
# Values below match docker/compose.dev.yml and are for LOCAL DEVELOPMENT ONLY.

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgres://skytech:skytech@localhost:5432/skytech
REDIS_URL=redis://localhost:6379
# Public origin of the site; mutating requests must come from it (CSRF Origin check).
APP_ORIGIN=http://localhost:3000
# Secure cookies work on http://localhost in modern browsers; keep true everywhere.
COOKIE_SECURE=true
SESSION_TTL_HOURS=168

# S3-compatible storage (MinIO locally, provider Object Storage in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skytech-media
S3_ACCESS_KEY=skytech
S3_SECRET_KEY=skytech-dev-secret
S3_FORCE_PATH_STYLE=true
# Base URL from which stored objects are publicly readable.
S3_PUBLIC_URL=http://localhost:9000/skytech-media

# --- Web (apps/web) ---
# Where Next.js (server side) reaches the API directly.
API_INTERNAL_URL=http://localhost:4000
# Exposed to the browser: base URL of public media (same as S3_PUBLIC_URL).
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/skytech-media
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests ---
TEST_DATABASE_URL=postgres://skytech:skytech@localhost:5432/skytech_test
TEST_S3_BUCKET=skytech-media-test
